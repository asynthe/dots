force_color_prompt=yes

shopt -s autocd

export HISTSIZE=10000
export HISTFILESIZE=120000

export PASSWORD_STORE_DIR=$HOME/git/auth/pass

bind '"\C-x":"lfcd\C-m"'
set -o ignoreeof

lfcd() {
    tmp="$(mktemp)"
    # `command` is needed in case `lfcd` is aliased to `lf`
    command lf -last-dir-path="$tmp" "$@"
    if [ -f "$tmp" ]; then
        dir="$(cat "$tmp")"
        rm -f "$tmp"
        if [ -d "$dir" ]; then
            if [ "$dir" != "$(pwd)" ]; then
                cd "$dir"
            fi
        fi
    fi
}


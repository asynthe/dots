focus-follows-mouse = false
window-inherit-font-size = true
window-inherit-working-directory = true
working-directory = home

window-padding-x = 14
window-padding-y = 14
#window-padding-balance = true

font-size = 12
font-family = TX-02
font-style = Condensed
font-style-bold = Bold Condensed
font-style-italic = Condensed Oblique
font-style-bold-italic = Bold Condensed Oblique

background-opacity = 0
unfocused-split-opacity = 0.85
background = #0d0d12
#background-opacity = 0.48
#foreground = #dddddd
#selection-background = #1c2f39
#selection-foreground = #dddddd
#cursor-color = #e6eaea

#custom-shader-animation = true
#custom-shader = shaders/animated-gradient-shader.glsl
#custom-shader = shaders/galaxy.glsl
#custom-shader = shaders/just-snow.glsl
#custom-shader = shaders/starfield-colors.glsl
#custom-shader = shaders/starfield.glsl

keybind = clear
confirm-close-surface = false

keybind = super+shift+r=reload_config
keybind = super+w=close_surface
keybind = super+shift+w=close_tab
keybind = super+n=new_window

keybind = super+backslash=new_split:right
keybind = super+shift+backslash=new_split:down
keybind = super+period=toggle_split_zoom
keybind = super+h=goto_split:left
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up
keybind = super+l=goto_split:right
keybind = super+shift+h=resize_split:left,40
keybind = super+shift+j=resize_split:down,40
keybind = super+shift+k=resize_split:up,40
keybind = super+shift+l=resize_split:right,40

keybind = super+t=new_tab
keybind = super+[=previous_tab
keybind = super+]=next_tab
keybind = super+tab=next_tab
keybind = super+shift+tab=previous_tab
keybind = super+shift+[=move_tab:-1
keybind = super+shift+]=move_tab:1
keybind = super+shift+left=move_tab:-1
keybind = super+shift+right=move_tab:1

keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

keybind = super+u=scroll_page_lines:-3
keybind = super+d=scroll_page_lines:3
keybind = super+up=scroll_page_lines:-3
keybind = super+down=scroll_page_lines:3

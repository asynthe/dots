# Yazi
# NOTE: In case of FUNCNEST error, then do `unset yy` then `\yazi` or `command yazi`
function yy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}
alias yazi='yy'
alias l='yy'
alias lf='yy'

# Atuin
function h() {
    local cmd
    cmd=$(atuin search --interactive --cmd-only 2>/dev/null)
    [[ -n "$cmd" ]] && print -z -- "$cmd"
}

# Books
book() {
  emulate -L zsh
  local root=${BOOK_DIR:-$HOME/archive/media/book/reading}
  [[ -d $root ]] || { print -ru2 "book: not a directory: $root"; return 1 }

  local preview=${DOTS_DIR:-$HOME/git/dots}/scripts/book_preview.sh
  local -a picks
  picks=("${(@f)$(cd -- "$root" && fd --type f -e pdf -e epub . | sort |
    fzf --multi \
        --prompt='book > ' \
        --header='enter: open in zathura   tab: select several' \
        --preview="'$preview' '$root'/{}" \
        --preview-window='right,55%,border-left')}")

  [[ -n ${picks[1]:-} ]] || return 0
  pdf "${(@)picks/#/$root/}"
}

# Zathura
pdf() {
  local f
  for f in "$@"; do
    setsid zathura "$f" >/dev/null 2>&1 &!
  done
}

# Flatpak
flatpak_check() {
  if ! command -v flatpak &>/dev/null; then
    echo "[!] Flatpak is not installed on this system. Please install it first." >&2
    return 1
  fi
}

flatpak_run() {
  local app_id="$1"
  flatpak_check || return 1
  if ! command flatpak info "$app_id" &>/dev/null; then
    read "reply?[?] $app_id is not installed. Install it now? [y/N] "
    if [[ "$reply" =~ ^[Yy]$ ]]; then
      flatpak install flathub "$app_id" || return 1
    else
      return 1
    fi
  fi
  flatpak run "$app_id"
}

fightcade() { flatpak_run com.fightcade.Fightcade }
ps3() { flatpak_run net.rpcs3.RPCS3 }
pinball()   { flatpak_run com.github.k4zmu2a.spacecadetpinball }
upscayl()   { flatpak_run org.upscayl.Upscayl }

# Personal repos, printed by .zshrc on every new shell: what's left to commit
# or push, per host. A repo with nothing to do prints nothing.
#
#   check_repo      only problems
#   check_repo -a   plus a line for each repo that's fine
#   check_repo -r   ask github/gitlab now instead of trusting the cache
#
# `record` is where they should live. Reality is checked against it and drift
# (a host missing, a private repo gone public) shows in red — change the line
# and the repo together. Repos resolve by name against a few roots, so the
# laptop (~/git) and the phone (flat ~/) both work, a move
# (pass -> auth) is one edit here, and anything not found is skipped. The
# slug is asynthe/<name> on both hosts.
#
# A new shell never waits on the network. What the hosts hold comes from a
# cache that a disowned job refreshes at most every 10 minutes; local state is
# read live. A push counts straight away, before the refresh sees it: a remote
# that pushes to the host with its tracking ref at HEAD is proof enough.
check_repo() {
  emulate -L zsh
  local -a record roots
  record=(
    # name   hosts          visibility
    "dots    github,gitlab  public"    # bootstrap.sh curls it raw from gitlab
    "flakes  github,gitlab  public"
    "notes   github,gitlab  private"
    "study   github,gitlab  private"
    "sakuhin github,gitlab  private"
    "auth    github,gitlab  private"
  )
  roots=("$HOME/git" "$HOME/ben" "$HOME")
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/check_repo

  local all=0 now=0 opt
  for opt; do
    case $opt in
      -a) all=1 ;;
      -r) now=1 ;;
      *)  print -u2 "usage: check_repo [-a] [-r]"; return 2 ;;
    esac
  done

  local red=$'\033[0;31m' yellow=$'\033[1;33m' green=$'\033[0;32m' nc=$'\033[0m'

  local -A repo_of
  local -a f todo
  local line root
  for line in $record; do
    f=(${=line})
    for root in $roots; do
      [[ -d $root/${f[1]}/.git || -d $root/${f[1]}/.jj ]] || continue
      repo_of[${f[1]}]=$root/${f[1]}
      todo+=("${f[1]}:${f[2]}")
      break
    done
  done

  # No cd anywhere: this runs at every prompt, and moving the shell's cwd to
  # print a status is how you end up somewhere unexpected.
  mkdir -p $cache
  local -a fresh=($cache/stamp(Nmm-10))
  if (( now )); then
    touch $cache/stamp
    ( _check_repo_refresh $cache $todo )
  elif (( ! $#fresh )); then
    touch $cache/stamp
    _check_repo_refresh $cache $todo &>/dev/null &!
  fi

  local name repo want head branch c sha s k l n
  local -a lines rv w pushers pushed_refs kinds
  local -A on
  for line in $record; do
    f=(${=line}); name=${f[1]}; want=${f[3]}
    repo=${repo_of[$name]}
    [[ -n $repo ]] || continue
    kinds=() on=()

    # jj has no index: a non-empty working copy is the uncommitted work.
    if [[ -d $repo/.jj ]] && (( $+commands[jj] )); then
      [[ "$(jj -R $repo log -r @ --no-graph -T empty 2>/dev/null)" == true ]] ||
        print -r -- "  ${yellow}[✎]${nc} Uncommitted changes in '$name'"
    elif [[ -n "$(git -C $repo status --porcelain 2>/dev/null)" ]]; then
      print -r -- "  ${yellow}[✎]${nc} Uncommitted changes in '$name'"
    fi

    head=$(git -C $repo rev-parse -q --verify HEAD 2>/dev/null)
    branch=$(git -C $repo symbolic-ref --short -q HEAD 2>/dev/null)
    : ${branch:=main}    # jj leaves HEAD detached
    rv=(${(f)"$(git -C $repo remote -v 2>/dev/null)"})

    for h in ${(s:,:)f[2]}; do
      # Remotes that push to this host, and where git last saw them.
      pushers=() pushed_refs=()
      for l in $rv; do
        w=(${=l})
        [[ ${w[3]} == '(push)' && ${w[2]} == *${h}.com[:/]* ]] || continue
        pushers+=(${w[1]})
        s=$(git -C $repo rev-parse -q --verify refs/remotes/${w[1]}/$branch) &&
          pushed_refs+=($s)
      done

      c=$cache/$name.$h
      k=
      if (( ! $#pushers )); then
        k=nopush    # a host nothing pushes to falls behind unnoticed
      elif [[ -z $head ]]; then
        :           # no commits yet
      elif [[ ! -f $c ]]; then
        # Never heard from the host: the tracking ref is all there is.
        (( $#pushed_refs )) &&
          (( $(git -C $repo rev-list --count HEAD --not $pushed_refs) )) && k=unpushed
      elif [[ $(<$c) == missing ]]; then
        k=missing
      else
        lines=(${(f)"$(<$c)"})
        [[ ${lines[1]} == $want ]] || on[vis]+="${on[vis]:+, }$h"
        sha=${${(M)lines:#*refs/heads/$branch}%%[[:space:]]*}
        if [[ -z $sha ]]; then
          k=nobranch
        elif [[ $sha == $head ]]; then
          :
        elif ! git -C $repo cat-file -e "$sha^{commit}" 2>/dev/null; then
          # The host has commits we don't. Unpushed work on top means diverged.
          (( $(git -C $repo rev-list --count HEAD --not --remotes) )) && k=diverged || k=behind
        elif git -C $repo merge-base --is-ancestor $sha HEAD; then
          (( ${pushed_refs[(Ie)$head]} )) || k=unpushed
        elif git -C $repo merge-base --is-ancestor HEAD $sha; then
          k=behind
        else
          k=diverged
        fi
      fi
      [[ -n $k ]] || continue
      (( ${+on[$k]} )) || kinds+=($k)
      on[$k]+="${on[$k]:+, }$h"
    done

    # One line per kind of problem, hosts that share it grouped.
    for k in $kinds; do
      case $k in
        unpushed) print -r -- "  ${red}[⚠]${nc} Unpushed changes in '$name' (${on[$k]})" ;;
        diverged) print -r -- "  ${red}[⚠]${nc} Diverged in '$name' (${on[$k]}), fetch first" ;;
        behind)   print -r -- "  ${yellow}[↓]${nc} Behind in '$name' (${on[$k]})" ;;
        missing)  print -r -- "  ${red}[✗]${nc} Missing remote for '$name' (${on[$k]})" ;;
        nobranch) print -r -- "  ${yellow}[?]${nc} No '$branch' branch for '$name' (${on[$k]})" ;;
        nopush)   print -r -- "  ${yellow}[!]${nc} No remote pushes to ${on[$k]} in '$name'" ;;
      esac
    done

    (( ${+on[vis]} )) &&
      print -r -- "  ${red}[!]${nc} '$name' is not $want on ${on[vis]}"
    (( all && ! $#kinds && ! ${+on[vis]} )) && print -r -- "  ${green}[✓]${nc} '$name' on ${f[2]/,/, } ($want)"
  done
  print ""
  return 0
}

# Asks every host about every repo, in parallel. Only ever run in a subshell:
# the exports are for the git calls below, not the interactive shell.
_check_repo_refresh() {
  emulate -L zsh
  local cache=$1 item h; shift
  export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=
  # Extend, don't replace: ~/.gitconfig's sshCommand is what picks the key.
  export GIT_SSH_COMMAND="${$(git config core.sshCommand):-ssh} -o BatchMode=yes -o ConnectTimeout=10"
  for item; do
    for h in ${(s:,:)${item#*:}}; do
      _check_repo_ask ${item%%:*} $h $cache/${item%%:*}.$h &
    done
  done
  wait
}

# One host's answer, written whole: "missing", or visibility then its heads.
_check_repo_ask() {
  emulate -L zsh
  local name=$1 fqdn=$2.com file=$3 out vis
  if ! out=$(git ls-remote --heads "git@${fqdn}:asynthe/${name}.git" 2>&1); then
    # No answer (offline, key not loaded) keeps what we knew. Only the host
    # itself saying so makes a repo missing.
    [[ $out == *(Permission denied|Could not resolve|timed out|refused|unreachable|closed by)* ]] &&
      return
    out=missing
  else
    # Anonymous https only works if the world can read it.
    git -c credential.helper= ls-remote "https://${fqdn}/asynthe/${name}.git" HEAD &>/dev/null &&
      vis=public || vis=private
    out="$vis"$'\n'"$out"
  fi
  print -r -- $out >| $file.tmp && mv -f $file.tmp $file
}

# NixOS garbage collection.
#
#   nix-clean          keep the last 2 system generations, then GC
#   nix-clean 5        keep 5
#   nix-clean -n       dry run: show what would go, delete nothing
#
# Two things have to happen in this order. Deleting generations only drops the
# profile symlinks; the store paths stay alive until a GC pass finds nothing
# pointing at them. Running `nix-collect-garbage` on its own reclaims almost
# nothing while old generations still root everything they reference.
nix-clean() {
  emulate -L zsh
  local keep=2 dry=0
  while (( $# )); do
    case $1 in
      -n|--dry-run) dry=1 ;;
      <->)          keep=$1 ;;
      *) print -ru2 "nix-clean: usage: nix-clean [-n] [keep=2]"; return 1 ;;
    esac
    shift
  done

  local sys=/nix/var/nix/profiles/system
  local before=$(du -sh /nix/store 2>/dev/null | cut -f1)
  print -r -- "store now: $before"

  # Never touch the booted or current generation, whatever the count says.
  # sudo first, on its own, so a failed auth is an error and not an empty
  # list that reads as "nothing to delete".
  sudo -v || { print -ru2 "nix-clean: need sudo to read the system profile"; return 1 }

  local -a all doomed
  all=(${(f)"$(sudo nix-env --list-generations -p $sys | awk '{print $1}')"})
  all=(${all:#})
  (( $#all )) || { print -ru2 "nix-clean: could not list generations"; return 1 }
  local current=$(readlink $sys | sed 's/[^0-9]//g')
  doomed=(${all[1,-$((keep+1))]})
  doomed=(${doomed:#$current})

  if (( ! $#doomed )); then
    print -r -- "nothing to delete: $#all generations, keeping $keep"
  else
    local show=$(( keep > $#all ? $#all : keep ))
    print -r -- "delete: ${(j:, :)doomed}   keep: ${(j:, :)all[-$show,-1]}"
    if (( dry )); then
      print -r -- "(dry run)"
    else
      sudo nix-env --delete-generations -p $sys $doomed
      sudo nix-env --delete-generations -p ~/.local/state/nix/profiles/profile +$keep 2>/dev/null
    fi
  fi

  if (( ! dry )); then
    sudo nix-collect-garbage --delete-old
    nix-collect-garbage --delete-old        # per-user roots
    sudo /run/current-system/bin/switch-to-configuration boot >/dev/null 2>&1 &&
      print -r -- "boot entries refreshed"
    print -r -- "store was $before, now $(du -sh /nix/store 2>/dev/null | cut -f1)"
  fi
}

# What is still holding the store open, biggest first. Run this when a GC
# frees less than expected — usually a result symlink in a project dir.
nix-roots() {
  emulate -L zsh
  nix-store --gc --print-roots 2>/dev/null |
    grep -v '^/proc/\|censored\|^{memory\|/var/nix/profiles/\|^{censored' |
    sort -u
}

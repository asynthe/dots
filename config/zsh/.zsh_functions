# Yazi, but cd to where it exited. FUNCNEST error: `unset yy`, then `\yazi`.
function yy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}
alias yazi='yy'
alias l='yy'
alias lf='yy'

# Atuin: pick a past command, put it on the prompt unrun.
function h() {
    local cmd
    cmd=$(atuin search --interactive --cmd-only 2>/dev/null)
    [[ -n "$cmd" ]] && print -z -- "$cmd"
}

# fzf over the reading shelf, opens the picks in zathura.
book() {
  emulate -L zsh
  local root=${BOOK_DIR:-$HOME/archive/media/book/reading}
  [[ -d $root ]] || { print -ru2 "book: not a directory: $root"; return 1 }

  local preview=${DOTS_DIR:-$HOME/git/dots}/scripts/book_preview.sh
  local -a picks
  picks=("${(@f)$(cd -- "$root" && fd --type f -e pdf -e epub . | sort |
    fzf --multi \
        --prompt='book > ' \
        --header='enter: open in zathura   tab: select several' \
        --preview="'$preview' '$root'/{}" \
        --preview-window='right,55%,border-left')}")

  [[ -n ${picks[1]:-} ]] || return 0
  pdf "${(@)picks/#/$root/}"
}

# Open PDFs detached, so the shell stays usable.
pdf() {
  local f
  for f in "$@"; do
    setsid zathura "$f" >/dev/null 2>&1 &!
  done
}

# Run detached: own session, no tty, output dropped. See docs/ZSH.md.
drop() {
  emulate -L zsh
  (( $# )) || { print -ru2 "drop: usage: drop <command> [args...]"; return 2 }
  command -v "$1" >/dev/null || { print -ru2 "drop: no such command: $1"; return 127 }
  setsid -f "$@" </dev/null >/dev/null 2>&1
}

# Same, output appended to ~/.local/state/drop/<cmd>.log.
dropl() {
  emulate -L zsh
  (( $# )) || { print -ru2 "dropl: usage: dropl <command> [args...]"; return 2 }
  command -v "$1" >/dev/null || { print -ru2 "dropl: no such command: $1"; return 127 }
  local log=${XDG_STATE_HOME:-$HOME/.local/state}/drop/${1:t}.log
  mkdir -p ${log:h} || return 1
  setsid -f "$@" </dev/null >>$log 2>&1
  print -r -- "dropl: $log"
}

# Flatpak: offer to install it on first run, then launch.
flatpak_check() {
  if ! command -v flatpak &>/dev/null; then
    echo "[!] Flatpak is not installed on this system. Please install it first." >&2
    return 1
  fi
}

flatpak_run() {
  local app_id="$1"
  flatpak_check || return 1
  if ! command flatpak info "$app_id" &>/dev/null; then
    read "reply?[?] $app_id is not installed. Install it now? [y/N] "
    if [[ "$reply" =~ ^[Yy]$ ]]; then
      flatpak install flathub "$app_id" || return 1
    else
      return 1
    fi
  fi
  flatpak run "$app_id"
}

fightcade() { flatpak_run com.fightcade.Fightcade }
ps3() { flatpak_run net.rpcs3.RPCS3 }
pinball()   { flatpak_run com.github.k4zmu2a.spacecadetpinball }
upscayl()   { flatpak_run org.upscayl.Upscayl }

# Terminal to nothing, to judge the hyprglass slab. See docs/ZSH.md.
blank() {
  emulate -L zsh
  setopt local_traps

  local restore=$'\e[?25h\e[?1049l'

  # `always` misses signals, so Ctrl-C needs its own trap to restore the screen.
  trap 'printf "%s" "$restore"; return 130' INT

  # Alt screen, not `clear`: the shell's screen comes back byte-for-byte.
  printf '\e[?1049h\e[2J\e[H\e[?25l'
  {
    # Modifiers alone send no byte, so holding Ctrl will not wake this.
    read -rsk1
  } always {
    printf '%s' "$restore"
  }
}

# Repo status at every prompt; -a all, -r refresh now. See docs/ZSH.md.
check_repo() {
  emulate -L zsh
  local -a record=(
    # name   hosts          visibility
    "dots    github,gitlab  public"    # bootstrap.sh curls it raw from gitlab
    "flakes  github,gitlab  public"
    "notes   github,gitlab  private"
    "study   github,gitlab  private"
    "sakuhin github,gitlab  private"
    "auth    github,gitlab  private"
  )
  local -a roots=("$HOME/git" "$HOME")
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/check_repo

  local all=0 now=0 opt
  for opt; do
    case $opt in
      -a) all=1 ;;
      -r) now=1 ;;
      *)  print -u2 "usage: check_repo [-a] [-r]"; return 2 ;;
    esac
  done

  local red=$'\033[0;31m' yellow=$'\033[1;33m' green=$'\033[0;32m' nc=$'\033[0m'

  # name -> path for every repo cloned here; "name:hosts" for the refresh.
  local -A path_of
  local -a f todo
  local line root
  for line in $record; do
    f=(${=line})
    for root in $roots; do
      [[ -d $root/${f[1]}/.git ]] || continue
      path_of[${f[1]}]=$root/${f[1]}
      todo+=("${f[1]}:${f[2]}")
      break
    done
  done

  local answer
  mkdir -p $cache
  local -a fresh=($cache/stamp(Nmm-10))
  if (( now || ! $#fresh )); then
    touch $cache/stamp
    # Answers for repos no longer here would never be read again.
    for answer in $cache/*.(github|gitlab)(N); do
      (( ${+path_of[${answer:t:r}]} )) || rm -f $answer
    done
    if (( now )); then
      ( _check_repo_refresh $cache $todo )
    else
      _check_repo_refresh $cache $todo &>/dev/null &!
    fi
  fi

  # No cd anywhere: this runs at every prompt.
  local name repo want head branch host sha ref kind remote dirty on
  local -a answer_lines remotes words pushers pushed_at kinds
  local -A hosts_with
  for line in $record; do
    f=(${=line}); name=${f[1]}; want=${f[3]}
    repo=${path_of[$name]}
    [[ -n $repo ]] || continue
    kinds=() hosts_with=()

    dirty=0
    [[ -n "$(git -C $repo status --porcelain 2>/dev/null)" ]] && dirty=1
    (( dirty )) && print -r -- "  ${yellow}[✎]${nc} Uncommitted changes in '$name'"

    head=$(git -C $repo rev-parse -q --verify HEAD)
    branch=$(git -C $repo symbolic-ref --short -q HEAD)
    : ${branch:=main}    # detached HEAD: compare against main
    remotes=(${(f)"$(git -C $repo remote -v)"})

    for host in ${(s:,:)f[2]}; do
      # Remotes that push to this host, and where git last saw their branch.
      pushers=() pushed_at=()
      for remote in $remotes; do
        words=(${=remote})    # name url (fetch|push)
        [[ ${words[3]} == '(push)' && ${words[2]} == *$host.com[:/]* ]] || continue
        pushers+=(${words[1]})
        ref=$(git -C $repo rev-parse -q --verify refs/remotes/${words[1]}/$branch) &&
          pushed_at+=($ref)
      done

      answer=$cache/$name.$host
      kind=
      if (( ! $#pushers )); then
        kind=nopush    # a host nothing pushes to falls behind unnoticed
      elif [[ -z $head ]]; then
        :              # no commits yet
      elif [[ ! -f $answer ]]; then
        # Never heard from the host: the tracking ref is all there is.
        (( $#pushed_at )) &&
          [[ -n "$(git -C $repo rev-list -1 HEAD --not $pushed_at)" ]] && kind=unpushed
      elif [[ $(<$answer) == missing ]]; then
        kind=missing
      else
        answer_lines=(${(f)"$(<$answer)"})
        [[ ${answer_lines[1]} == $want ]] || hosts_with[visibility]+="${hosts_with[visibility]:+, }$host"
        sha=${${(M)answer_lines:#*refs/heads/$branch}%%[[:space:]]*}
        if [[ -z $sha ]]; then
          kind=nobranch
        elif [[ $sha == $head ]]; then
          :
        elif ! git -C $repo cat-file -e "$sha^{commit}" 2>/dev/null; then
          # The host has commits we don't. Unpushed work on top means diverged.
          [[ -n "$(git -C $repo rev-list -1 HEAD --not --remotes)" ]] && kind=diverged || kind=behind
        elif git -C $repo merge-base --is-ancestor $sha HEAD; then
          (( ${pushed_at[(Ie)$head]} )) || kind=unpushed
        elif git -C $repo merge-base --is-ancestor HEAD $sha; then
          kind=behind
        else
          kind=diverged
        fi
      fi
      [[ -n $kind ]] || continue
      (( ${+hosts_with[$kind]} )) || kinds+=($kind)
      hosts_with[$kind]+="${hosts_with[$kind]:+, }$host"
    done

    # One line per kind of problem, the hosts that share it grouped.
    for kind in $kinds; do
      on=${hosts_with[$kind]}
      case $kind in
        unpushed) print -r -- "  ${red}[⚠]${nc} Unpushed changes in '$name' ($on)" ;;
        diverged) print -r -- "  ${red}[⚠]${nc} Diverged in '$name' ($on), fetch first" ;;
        behind)   print -r -- "  ${yellow}[↓]${nc} Behind in '$name' ($on)" ;;
        missing)  print -r -- "  ${red}[✗]${nc} Missing remote for '$name' ($on)" ;;
        nobranch) print -r -- "  ${yellow}[?]${nc} No '$branch' branch for '$name' ($on)" ;;
        nopush)   print -r -- "  ${yellow}[!]${nc} No remote pushes to $on in '$name'" ;;
      esac
    done
    (( ${+hosts_with[visibility]} )) &&
      print -r -- "  ${red}[!]${nc} '$name' is not $want on ${hosts_with[visibility]}"

    (( all && ! dirty && ! $#hosts_with )) &&
      print -r -- "  ${green}[✓]${nc} '$name' on ${f[2]/,/, } ($want)"
  done
  print ""
  return 0
}

# Asks every host in parallel. Subshell only: the exports are for git.
_check_repo_refresh() {
  emulate -L zsh
  local cache=$1 item host; shift
  export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true SSH_ASKPASS=
  # Extend, don't replace: ~/.gitconfig's sshCommand is what picks the key.
  export GIT_SSH_COMMAND="${$(git config core.sshCommand):-ssh} -o BatchMode=yes -o ConnectTimeout=10"
  for item; do
    for host in ${(s:,:)${item#*:}}; do
      _check_repo_ask ${item%%:*} $host $cache/${item%%:*}.$host &
    done
  done
  wait
}

# One host's answer, written whole: "missing", or visibility then its heads.
_check_repo_ask() {
  emulate -L zsh
  local name=$1 fqdn=$2.com file=$3 out vis
  if ! out=$(git ls-remote --heads "git@${fqdn}:asynthe/${name}.git" 2>&1); then
    # Only the host itself makes a repo missing; no answer keeps what we knew.
    [[ $out == *(Permission denied|Could not resolve|timed out|refused|unreachable|closed by)* ]] &&
      return
    out=missing
  else
    # Anonymous https only works if the world can read it.
    git -c credential.helper= ls-remote "https://${fqdn}/asynthe/${name}.git" HEAD &>/dev/null &&
      vis=public || vis=private
    out="$vis"$'\n'"$out"
  fi
  print -r -- $out >| $file.tmp && mv -f $file.tmp $file
}

# Prune system generations (default 2), then GC. See docs/ZSH.md.
nix-clean() {
  emulate -L zsh
  local keep=2 dry=0
  while (( $# )); do
    case $1 in
      -n|--dry-run) dry=1 ;;
      <->)          keep=$1 ;;
      *) print -ru2 "nix-clean: usage: nix-clean [-n] [keep=2]"; return 1 ;;
    esac
    shift
  done

  local sys=/nix/var/nix/profiles/system
  local before=$(du -sh /nix/store 2>/dev/null | cut -f1)
  print -r -- "store now: $before"

  # sudo alone first: a failed auth must be an error, not an empty list.
  sudo -v || { print -ru2 "nix-clean: need sudo to read the system profile"; return 1 }

  local -a all doomed
  all=(${(f)"$(sudo nix-env --list-generations -p $sys | awk '{print $1}')"})
  all=(${all:#})
  (( $#all )) || { print -ru2 "nix-clean: could not list generations"; return 1 }
  local current=$(readlink $sys | sed 's/[^0-9]//g')
  doomed=(${all[1,-$((keep+1))]})
  doomed=(${doomed:#$current})

  if (( ! $#doomed )); then
    print -r -- "nothing to delete: $#all generations, keeping $keep"
  else
    local show=$(( keep > $#all ? $#all : keep ))
    print -r -- "delete: ${(j:, :)doomed}   keep: ${(j:, :)all[-$show,-1]}"
    if (( dry )); then
      print -r -- "(dry run)"
    else
      sudo nix-env --delete-generations -p $sys $doomed
      sudo nix-env --delete-generations -p ~/.local/state/nix/profiles/profile +$keep 2>/dev/null
    fi
  fi

  if (( ! dry )); then
    sudo nix-collect-garbage --delete-old
    nix-collect-garbage --delete-old        # per-user roots
    sudo /run/current-system/bin/switch-to-configuration boot >/dev/null 2>&1 &&
      print -r -- "boot entries refreshed"
    print -r -- "store was $before, now $(du -sh /nix/store 2>/dev/null | cut -f1)"
  fi
}

# What still roots the store, when a GC frees less than expected.
nix-roots() {
  emulate -L zsh
  nix-store --gc --print-roots 2>/dev/null |
    grep -v '^/proc/\|censored\|^{memory\|/var/nix/profiles/\|^{censored' |
    sort -u
}

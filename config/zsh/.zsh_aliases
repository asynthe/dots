alias aliases='nvim $ZDOTDIR/.zsh_aliases'
alias bt='bluetoothctl' #'bluetuith'
alias chat='weechat'
alias cp='rsync -ah --info=progress2'
alias hist='h'
alias info='mediainfo'
alias m='ncmpcpp'
alias n='nvim'
alias net='impala'
alias netint='ip -br -c a | grep -v "^veth"'
alias off='poweroff'
alias rm='rm -i'
alias v='alsamixer'
alias vis='projectM-pulseaudio &>/dev/null & disown'
alias vv='wiremix'
alias wm='uwsm start -e -D Hyprland hyprland.desktop'
alias yt-mp3='yt-dlp -x --audio-format best'
alias yt-mp4='yt-dlp'

alias c='opencode'
alias cl='claude'
alias cx='codex'

# terminal image viewing, per terminal
if [[ "$TERM_PROGRAM" == "ghostty" ]]; then
    alias img='kitty +kitten icat'
elif [[ "$TERM_PROGRAM" == "WezTerm" ]]; then
    alias img='wezterm imgcat'
fi

alias ls='eza --icons --group-directories-first'
alias lg='eza --long --git --group-directories-first'


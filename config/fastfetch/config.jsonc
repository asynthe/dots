{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "size": {
            "ndigits": 1
        }
    },
    "modules": [
        // 4 breaks centre the 10 info lines against the 19-line Gentoo logo; adjust if modules change.
        "break",
        "break",
        "break",
        "break",
        "title",
        "separator",
        "os",
        {
            "type": "host",
            "format": "{family} ({name})"
        },
        {
            "type": "command",
            "key": "Kernel",
            "text": "echo Linux $(uname -r | cut -d- -f1)"
        },
        {
            "type": "wm",
            "format": "{pretty-name}"
        },
        {
            "type": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "hideType": "integrated",
            "format": "{vendor} {name~0,-22}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "format": "{size-used} / {size-total}"
        }
    ]
}

<?xml version="1.0"?>
<!-- NixOS: cores are linked into the system profile by the retroarch aspect;
     ES-DE's bundled rules only know FHS and flatpak paths. -->
<ruleList>
    <core name="RETROARCH">
        <rule type="corepath">
            <entry>/run/current-system/sw/lib/retroarch/cores</entry>
        </rule>
    </core>
</ruleList>
